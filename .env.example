# FinStream configuration. Copy to .env and adjust: cp .env.example .env
# Every variable is documented in docs/configuration.md (AGENTS.md GR-4).
# .env is never committed and agents never read it (GR-5).

# --- Database ---
POSTGRES_USER=finstream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finstream
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://finstream:change-me@db:5432/finstream
TIMESCALEDB_ENABLED=true

# --- Source: Yahoo Finance ---
YAHOO_SYMBOLS=GC=F,SI=F,GLD,SLV,CL=F,NG=F,^GSPC,^IXIC,^DJI,^RUT,^VIX,^FTSE,^STOXX50E,SPY,QQQ,IWM,TLT,EURUSD=X,USDPLN=X,DX-Y.NYB,BTC-USD,ETH-USD,^TNX

# --- Schedules ---
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MISFIRE_GRACE_SECONDS=300
INTRADAY_ENABLED=true
INTRADAY_INTERVAL=1h
INTRADAY_EVERY_MINUTES=60
INTRADAY_LOOKBACK=5d
DAILY_ENABLED=true
# Day-of-week must use names: APScheduler counts 0 as Monday, classic cron counts it as Sunday
# (docs/research/2026-09-16-apscheduler-tenacity.md).
DAILY_CRON=30 22 * * mon-fri
DAILY_LOOKBACK=10d
BACKFILL_ON_START=false
BACKFILL_PERIOD=2y

# --- Retries ---
RETRY_MAX_ATTEMPTS=5
RETRY_MAX_WAIT_SECONDS=60

# --- Dashboard (services/dashboard) ---
DASHBOARD_PORT=8501
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_DEFAULT_INTERVAL=1d
DASHBOARD_MAX_ROWS=5000

# --- Health & logging ---
HEARTBEAT_FILE=/tmp/finstream-ingestor.heartbeat
HEARTBEAT_EVERY_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=json
